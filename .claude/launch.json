{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "registry",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "next",
      "runtimeExecutable": "./node_modules/.bin/next",
      "runtimeArgs": ["dev", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "next-auto",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "NEXT_DIST_DIR=.next-preview exec ./node_modules/.bin/next dev"
      ],
      "port": 3001,
      "autoPort": true
    }
  ]
}
